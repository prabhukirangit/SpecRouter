# SpecRouter configuration. Copy to ".env" and edit.
# Real environment variables override values in this file.

# --- Source adapter (documentation type) ------------------------------------
# openapi (default) | custom (config-driven HTML scraper) | module:callable (plugin)
# SPECROUTER_SOURCE_ADAPTER=openapi

# --- Spec source (required for the 'openapi' adapter) ------------------------
# Remote URL or a file:// path to the OpenAPI/Swagger spec (JSON or YAML).
SPECROUTER_SPEC_URL=http://localhost:8000/openapi.json
# SPECROUTER_SPEC_URL=file:///absolute/path/to/sample/petstore.json

# --- Custom adapter (when SPECROUTER_SOURCE_ADAPTER=custom) -------------------
# Path to a CSS-selector rules file (YAML/JSON). Needs: pip install specrouter[scrape]
# Don't hand-write it — generate it: `specrouter init-rules <doc-url>` (uses the
# SPECROUTER_ENRICH_* model settings below). See examples/custom_rules.example.yaml.
# SPECROUTER_BASE_URL = the API host execute_tool calls.
# SPECROUTER_CUSTOM_RULES=./custom_rules.yaml
# SPECROUTER_CUSTOM_CONCURRENCY=8

# --- Live API target --------------------------------------------------------
# The API host (FQDN) that execute_tool calls. Auto-derived from the spec's servers[]
# (a relative servers[] like "/api/v3" is resolved against the spec's origin).
# SET THIS when your API lives at a different origin than your spec (docs on a portal /
# GitHub / wiki, API on its own FQDN), or when servers[] is relative/templated/missing.
# The override always wins. Safe to leave set; optional only if servers[] is already the
# correct absolute API URL.
SPECROUTER_BASE_URL=http://localhost:8000

# --- Index cache ------------------------------------------------------------
# SPECROUTER_CACHE_DIR=./.specrouter

# --- Retrieval tuning -------------------------------------------------------
# SPECROUTER_TOP_K=5
# SPECROUTER_RRF_K=60
# SPECROUTER_K1=1.5

# Fuzzy BM25F term expansion (typo tolerance). Disable for max speed on huge specs.
# SPECROUTER_FUZZY_EXPAND=true
# SPECROUTER_FUZZY_MAX_RATIO=0.34
# SPECROUTER_FUZZY_MIN_TOKEN_LEN=4
# SPECROUTER_FUZZY_WEIGHT_POWER=2.0

# --- Output schema ----------------------------------------------------------
# Emit a separate MCP-native outputSchema (primary 2xx JSON response) per tool.
# SPECROUTER_INCLUDE_OUTPUT_SCHEMA=true
# SPECROUTER_OUTPUT_SCHEMA_MAX_DEPTH=4

# --- AI description enrichment (opt-in, build-time only) --------------------
# Requires a provider extra: pip install specrouter[ai-openai|ai-anthropic|ai-google|ai-ollama]
# SPECROUTER_ENRICH=false
# SPECROUTER_ENRICH_PROVIDER=openai          # openai | anthropic | google_genai | ollama
# SPECROUTER_ENRICH_MODEL=gpt-4o-mini
# SPECROUTER_ENRICH_BASE_URL=http://localhost:11434/v1   # Ollama / OpenAI-compatible local
# SPECROUTER_ENRICH_API_KEY=                 # else OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_API_KEY
# SPECROUTER_ENRICH_CONCURRENCY=5
# SPECROUTER_ENRICH_MAX_SENTENCES=4

# --- Auth for execute_tool (none | bearer | api_key | basic | custom | plugin) ---
SPECROUTER_AUTH_MODE=none

# bearer:
# SPECROUTER_BEARER_TOKEN=your-token-here

# api_key:
# SPECROUTER_API_KEY=your-key-here
# SPECROUTER_API_KEY_HEADER=X-API-Key

# basic:
# SPECROUTER_BASIC_USER=username
# SPECROUTER_BASIC_PASS=password

# custom / any mode: static headers merged into every request (JSON object).
# SPECROUTER_EXTRA_HEADERS={"X-Tenant":"acme"}

# plugin: module:callable hook (request_kwargs, settings) -> request_kwargs
# SPECROUTER_AUTH_PLUGIN=mypackage.auth:sign_request

# --- Networking -------------------------------------------------------------
# Per-phase read/write/pool timeout (s); connect timeout is separate. A slow
# upstream returns a structured 504/502 rather than blocking the caller.
# SPECROUTER_REQUEST_TIMEOUT=60
# SPECROUTER_CONNECT_TIMEOUT=10

# --- Logging (rotating file handler) ----------------------------------------
# Single combined log of every step: indexing, enrichment, discovery, and each
# executed route (FQDN + args + status). File/stderr only — never stdout (stdio MCP).
# See docs/LOGGING.md. Auth secrets are never logged.
# SPECROUTER_LOG_DIR=logs                 # -> ./logs/specrouter.log
# SPECROUTER_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# SPECROUTER_LOG_MAX_BYTES=5000000        # rotate at ~5 MB
# SPECROUTER_LOG_BACKUP_COUNT=5           # keep specrouter.log.1 .. .5
# SPECROUTER_LOG_CONSOLE=false            # also echo to stderr (never stdout)
# SPECROUTER_LOG_ARGS=true                # include execute_tool args in the audit line
